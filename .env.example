# Copie para .env e preencha. NUNCA faça commit do .env.

# true = Jira simulado em memória (padrão, não precisa de credenciais)
AGENT_OS_USE_MOCK=true

# Jira Cloud (necessário apenas com AGENT_OS_USE_MOCK=false ou --real-jira)
JIRA_BASE_URL=https://sua-organizacao.atlassian.net
JIRA_EMAIL=voce@empresa.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AGT

# Roteador com LLM (opcional; requer: pip install -e ".[llm]")
AGENT_OS_USE_LLM_ROUTER=false
ANTHROPIC_API_KEY=
AGENT_OS_MODEL=claude-sonnet-5-5
